[Unit]
Description=SnapPipe TCP-over-QUIC tunnel (server side, relay host)
Documentation=https://github.com/LOUST-PRO/SnapPipe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=snappipe
Group=snappipe
# Server-side skeleton: listen on the QUIC port and bridge every
# accepted stream to a single local TCP backend. Replace the placeholders
# below with values appropriate to your deployment:
#
#   <operator-keys>             absolute path to the operator's
#                               keypair directory. The serve side
#                               requires ONLY the issuer's *public*
#                               half (relay.public); the secret stays
#                               on the offline ticket-issuance host.
#                               The relay identity is provisioned
#                               ONCE during the v0.2.x bootstrap; do
#                               not regenerate it here or you will
#                               invalidate every issued ticket and
#                               trust-store entry.
#   <tcp-backend-host:port>     the local TCP service the tunnel
#                               proxies to
#
# Adjust the QUIC port if 0.0.0.0:4443 is already in use on the host;
# see docs/OPERATIONAL-DEPLOYMENT.md for the rationale.
ExecStart=/usr/local/bin/snappipe tunnel serve \
  --issuer-public-key <operator-keys>/relay.public \
  --public-key <operator-keys>/relay.public \
  --quic-bind 0.0.0.0:4443 \
  --target <tcp-backend-host:port>
Restart=on-failure
RestartSec=5
# Hardening: deny /tmp writes, restrict filesystem, drop caps.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
# CAP_NET_BIND_SERVICE is included so the unit works on hosts where
# the QUIC port is gated by raw-QUIC bind capability for symmetry with
# TCP listeners. Omit it if the bind succeeds without the capability.

[Install]
WantedBy=multi-user.target